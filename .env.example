# Supabase project credentials.
# Local: copy this file to .env and fill in the values.
# Netlify: add the same two variables under Site settings -> Environment variables.
#
# Both values are safe to expose in the browser — the anon key only grants what
# the RLS policies in supabase/migrations/0001_init.sql allow (public read,
# admin-only write).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
